APP_NAME="FansAPI Profile Refresh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fansapi
DB_USERNAME=fansapi
DB_PASSWORD=secret

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

SCOUT_DRIVER=database

# Dead letters live in the database (Laravel's failed_jobs table).
QUEUE_FAILED_DRIVER=database-uuids

# ---------------------------------------------------------------------------
# Profile source: "fixture" (private local upstream) or "ofapi" (live provider).
# The UI shows a LIVE / FIXTURE badge driven by this value.
# ---------------------------------------------------------------------------
PROFILE_SOURCE=fixture

OFAPI_BASE_URL=https://app.onlyfansapi.com/api
# Never commit a real token. Put yours in the git-ignored .env file.
OFAPI_TOKEN=

FIXTURE_BASE_URL=http://fixture:9000

# Horizon worker recycling (MiB of PHP allocation per worker process).
HORIZON_MEMORY_LIMIT=96

# Set to 1 only while running `php artisan fans:memory`.
MEMORY_PROBE=0

# Host uid:gid, so containers do not write root-owned files into the mount.
DOCKER_USER=1000:1000
